@model ScoutedTeamDto

@{
    ViewData["Title"] = "Remove a team";
}

<h1 class="h3">Remove a team</h1>

<h3 class="h5">Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.GameCount)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.GameCount)
        </dd>
    </dl>
    @if (Model.IsOwnTeam)
    {
        <div class="alert alert-warning" role="alert">This is your own team. It cannot be removed.</div>
    }
    else if (Model.GameCount > 0)
    {
        <div class="alert alert-warning" role="alert">
            @Model.Name played in @DisplayText.Count(Model.GameCount, "game", "games") on film. A team can only be removed when it has none.
        </div>
    }
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        @if (!Model.IsOwnTeam && Model.GameCount == 0)
        {
            <input type="submit" value="Delete" class="btn btn-danger" /><text> |</text>
        }
        <a asp-action="Index">Back to List</a>
    </form>
</div>
