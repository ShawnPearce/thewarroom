@model NewWeekViewModel

@{
    ViewData["Title"] = "New week";
}

<h1 class="h3">New week's depth chart</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="NewWeek">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Week.WeekStartDate" class="control-label"></label>
                <input asp-for="Week.WeekStartDate" type="date" class="form-control" />
                <span asp-validation-for="Week.WeekStartDate" class="text-danger"></span>
                <div class="form-text">Pick any day; the chart is kept for the week starting on that Monday.</div>
            </div>

            <div class="form-group">
                <label asp-for="Week.Label" class="control-label"></label>
                <input asp-for="Week.Label" class="form-control" placeholder="for example: vs Central" />
                <span asp-validation-for="Week.Label" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Week.CopyFromWeekId" class="control-label"></label>
                <select asp-for="Week.CopyFromWeekId" class="form-select">
                    <option value="">An empty depth chart</option>
                    @foreach (var week in Model.Weeks)
                    {
                        <option value="@week.Id">A copy of the @DisplayText.WeekOf(week).Replace("Week of", "week of")</option>
                    }
                </select>
                <div class="form-text">A copy leaves out players who have since been deactivated or have left a position's group.</div>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to the depth chart</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
