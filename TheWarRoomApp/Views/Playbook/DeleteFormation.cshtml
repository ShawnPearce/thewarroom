@model FormationDto

@{
    ViewData["Title"] = "Delete formation";
}

<h1 class="h3">Delete formation</h1>

<h3 class="h5">Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">Playbook</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PlaybookName)
        </dd>
    </dl>
    <div class="row mb-3">
        <div class="col-lg-6">
            <canvas class="wr-diagram" data-diagram="@Model.DiagramJson" role="img" aria-label="Diagram of the @Model.Name formation"></canvas>
        </div>
    </div>
    @if (Model.Plays.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            This formation still has @DisplayText.Count(Model.Plays.Count, "play", "plays"). A formation can only be deleted when it has none.
        </div>
    }
    else if (!Model.CanPublish)
    {
        <div class="alert alert-info" role="status">
            Your request to delete is sent to the head coach. The formation stays in the playbook until it is approved.
        </div>
    }
    <form asp-action="DeleteFormation">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="playbookId" value="@Model.PlaybookId" />
        @if (Model.Plays.Count == 0)
        {
            <input type="submit" value="Delete" class="btn btn-danger" /><text> |</text>
        }
        <a asp-action="Formation" asp-route-id="@Model.Id">Back to the formation</a>
    </form>
</div>

@section Scripts {
    <partial name="_DiagramScripts" />
}
