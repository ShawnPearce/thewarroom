@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    bool isPlayer = Model.Me.Role == UserRole.Player;
    var nextEvent = Model.NextEvents.FirstOrDefault();
}

<section class="wr-welcome">
    <div>
        <p class="wr-eyebrow">@User.GetRoleLabel() &middot; @Model.Me.TeamName</p>
        <h1 class="wr-welcome-title">Welcome, @Model.Me.FirstName</h1>
    </div>
    <p class="wr-welcome-date">@DateTime.Today.ToString("dddd, MMMM d")</p>
</section>

@* The week at a glance: each tile leads to its page *@
<div class="wr-tiles">
    @if (nextEvent != null)
    {
        <a class="wr-tile" asp-controller="Schedule" asp-action="Details" asp-route-id="@nextEvent.Id">
            <span class="wr-tile-label"><svg class="wr-icon wr-icon-sm"><use href="#i-calendar"></use></svg>Next up</span>
            <span class="wr-tile-value">@nextEvent.Title</span>
            <span class="wr-tile-sub">@DisplayText.Date(nextEvent.EventDate), @DisplayText.Times(nextEvent.StartTime, nextEvent.EndTime)</span>
        </a>
    }
    else
    {
        <a class="wr-tile" asp-controller="Schedule" asp-action="Index">
            <span class="wr-tile-label"><svg class="wr-icon wr-icon-sm"><use href="#i-calendar"></use></svg>Next up</span>
            <span class="wr-tile-value">Nothing scheduled</span>
            <span class="wr-tile-sub">from today onwards</span>
        </a>
    }

    @if (isPlayer)
    {
        <a class="wr-tile" asp-controller="DepthChart" asp-action="Index">
            <span class="wr-tile-label"><svg class="wr-icon wr-icon-sm"><use href="#i-depth"></use></svg>Your spots</span>
            <span class="wr-tile-value">@Model.MyPlacements.Count</span>
            <span class="wr-tile-sub">
                @(Model.MyPlacements.Any(p => p.Rank == 1) ? "starting at " + string.Join(", ", Model.MyPlacements.Where(p => p.Rank == 1).Select(p => p.PositionName))
                    : "on this week's depth chart")
            </span>
        </a>
        <a class="wr-tile" asp-controller="Cutups" asp-action="Index">
            <span class="wr-tile-label"><svg class="wr-icon wr-icon-sm"><use href="#i-film"></use></svg>Film for you</span>
            <span class="wr-tile-value">@Model.Cutups.Count</span>
            <span class="wr-tile-sub">@(Model.Cutups.Count == 1 ? "cutup shared with you" : "cutups shared with you")</span>
        </a>
        <a class="wr-tile" asp-controller="Activity" asp-action="Mine">
            <span class="wr-tile-label"><svg class="wr-icon wr-icon-sm"><use href="#i-clock"></use></svg>Study time this week</span>
            <span class="wr-tile-value">@DisplayText.StudyTime((Model.MyWeek?.FilmSeconds ?? 0) + (Model.MyWeek?.PlaybookSeconds ?? 0))</span>
            <span class="wr-tile-sub">film and playbook</span>
        </a>
    }
    else
    {
        <a class="wr-tile" asp-controller="DepthChart" asp-action="Index">
            <span class="wr-tile-label"><svg class="wr-icon wr-icon-sm"><use href="#i-depth"></use></svg>Depth chart</span>
            <span class="wr-tile-value">@(Model.Week == null ? "Not started" : $"Week of {Model.Week.WeekStartDate:MMM d}")</span>
            <span class="wr-tile-sub">
                @(Model.Week == null ? "no week has been made yet" : string.IsNullOrWhiteSpace(Model.Week.Label) ? "this week's chart" : Model.Week.Label)
            </span>
        </a>
        <a class="wr-tile" asp-controller="Approvals" asp-action="Index">
            <span class="wr-tile-label"><svg class="wr-icon wr-icon-sm"><use href="#i-check"></use></svg>Playbook changes</span>
            <span class="wr-tile-value">@Model.WaitingChanges.Count</span>
            <span class="wr-tile-sub">@(Model.Me.Role == UserRole.HeadCoach ? "waiting for your decision" : "waiting for the head coach")</span>
        </a>
        <a class="wr-tile" asp-controller="Cutups" asp-action="Index">
            <span class="wr-tile-label"><svg class="wr-icon wr-icon-sm"><use href="#i-cutups"></use></svg>Cutups</span>
            <span class="wr-tile-value">@Model.Cutups.Count</span>
            <span class="wr-tile-sub">@(Model.Cutups.Count == 1 ? "cutup made" : "cutups made")</span>
        </a>
    }
</div>

<div class="row g-4">
    @if (Model.Me.Role == UserRole.Player)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header wr-card-title"><svg class="wr-icon wr-icon-sm"><use href="#i-depth"></use></svg>Your depth chart spots</div>
                <div class="card-body">
                    @if (Model.Week == null)
                    {
                        <p class="mb-0 text-muted">Your coaches have not posted a depth chart yet.</p>
                    }
                    else if (Model.MyPlacements.Count == 0)
                    {
                        <p class="text-muted">You are not listed on the current depth chart (@DisplayText.WeekOf(Model.Week)).</p>
                    }
                    else
                    {
                        <p class="text-muted small">@DisplayText.WeekOf(Model.Week)</p>
                        <ul class="list-unstyled mb-3">
                            @foreach (var placement in Model.MyPlacements)
                            {
                                <li>
                                    <strong>@placement.PositionName</strong>:
                                    @DisplayText.Ordinal(placement.Rank) of @placement.PlayersAtPosition
                                    @if (placement.Rank == 1)
                                    {
                                        <span class="badge text-bg-success">Starter</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (Model.Week != null)
                    {
                        <a class="wr-more" asp-controller="DepthChart" asp-action="Index">See the full depth chart<svg class="wr-icon wr-icon-sm"><use href="#i-arrow"></use></svg></a>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header wr-card-title"><svg class="wr-icon wr-icon-sm"><use href="#i-depth"></use></svg>Depth chart</div>
                <div class="card-body">
                    @if (Model.Week == null)
                    {
                        <p class="text-muted">The team has no depth chart yet.</p>
                        <a class="wr-more" asp-controller="DepthChart" asp-action="Index">Open the depth chart<svg class="wr-icon wr-icon-sm"><use href="#i-arrow"></use></svg></a>
                    }
                    else
                    {
                        <p>@DisplayText.WeekOf(Model.Week)</p>
                        <a class="wr-more" asp-controller="DepthChart" asp-action="Index">Open this week's depth chart<svg class="wr-icon wr-icon-sm"><use href="#i-arrow"></use></svg></a>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header wr-card-title"><svg class="wr-icon wr-icon-sm"><use href="#i-calendar"></use></svg>Next on the schedule</div>
            <div class="card-body">
                @if (Model.NextEvents.Count == 0)
                {
                    <p class="text-muted">Nothing is scheduled from today onwards.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-3">
                        @foreach (var item in Model.NextEvents)
                        {
                            <li class="mb-2">
                                <a asp-controller="Schedule" asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                                <span class="badge wr-event-@item.EventType.ToString().ToLower()">@DisplayText.Event(item.EventType)</span>
                                <div class="small text-muted">
                                    @DisplayText.Date(item.EventDate), @DisplayText.Times(item.StartTime, item.EndTime) &middot; @item.Location
                                </div>
                            </li>
                        }
                    </ul>
                }
                <a class="wr-more" asp-controller="Schedule" asp-action="Index">See the full schedule<svg class="wr-icon wr-icon-sm"><use href="#i-arrow"></use></svg></a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header wr-card-title"><svg class="wr-icon wr-icon-sm"><use href="#i-playbook"></use></svg>Playbook</div>
            <div class="card-body">
                @if (Model.Playbooks.Count == 0)
                {
                    <p class="mb-0 text-muted">No playbook is shared with you yet.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var playbook in Model.Playbooks)
                        {
                            <li class="mb-1">
                                <a asp-controller="Playbook" asp-action="Details" asp-route-id="@playbook.Id">@playbook.Name</a>
                                <span class="small text-muted">
                                    @DisplayText.Count(playbook.FormationCount, "formation", "formations"),
                                    @DisplayText.Count(playbook.PlayCount, "play", "plays")
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header wr-card-title"><svg class="wr-icon wr-icon-sm"><use href="#i-film"></use></svg>@(isPlayer ? "Film for you" : "Cutups")</div>
            <div class="card-body">
                @if (Model.Cutups.Count == 0)
                {
                    <p class="text-muted">@(Model.Me.Role == UserRole.Player ? "No film has been shared with you yet." : "No cutups have been made yet.")</p>
                }
                else
                {
                    <ul class="list-unstyled mb-3">
                        @foreach (var cutup in Model.Cutups.Take(3))
                        {
                            <li class="mb-1">
                                <a asp-controller="Cutups" asp-action="Details" asp-route-id="@cutup.Id">@cutup.Name</a>
                                <span class="small text-muted">@DisplayText.Count(cutup.PlayCount, "play", "plays"), @TimeText.Length(cutup.DurationMs)</span>
                            </li>
                        }
                    </ul>
                }
                @if (Model.Me.Role == UserRole.Player)
                {
                    <a class="wr-more" asp-controller="Cutups" asp-action="Index">See all your film<svg class="wr-icon wr-icon-sm"><use href="#i-arrow"></use></svg></a>
                }
                else
                {
                    <a class="wr-more" asp-controller="Film" asp-action="Index">Open game film<svg class="wr-icon wr-icon-sm"><use href="#i-arrow"></use></svg></a>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header wr-card-title"><svg class="wr-icon wr-icon-sm"><use href="#i-clock"></use></svg>@(isPlayer ? "Your study time this week" : "Study time")</div>
            <div class="card-body">
                @if (Model.Me.Role != UserRole.Player)
                {
                    <p class="text-muted">How long your players were signed in, watched film and read the playbook.</p>
                    <a class="wr-more" asp-controller="Activity" asp-action="Index">See this week's study time<svg class="wr-icon wr-icon-sm"><use href="#i-arrow"></use></svg></a>
                }
                else
                {
                    @if (Model.MyWeek != null)
                    {
                        <dl class="row mb-2">
                            <dt class="col-sm-5">Signed in</dt>
                            <dd class="col-sm-7">@DisplayText.StudyTime(Model.MyWeek.LoginSeconds)</dd>
                            <dt class="col-sm-5">Film</dt>
                            <dd class="col-sm-7">@DisplayText.StudyTime(Model.MyWeek.FilmSeconds)</dd>
                            <dt class="col-sm-5">Playbook</dt>
                            <dd class="col-sm-7">@DisplayText.StudyTime(Model.MyWeek.PlaybookSeconds)</dd>
                        </dl>
                    }
                    <a class="wr-more" asp-controller="Activity" asp-action="Mine">See how it is counted<svg class="wr-icon wr-icon-sm"><use href="#i-arrow"></use></svg></a>
                }
            </div>
        </div>
    </div>

    @if (Model.Me.Role != UserRole.Player)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header wr-card-title"><svg class="wr-icon wr-icon-sm"><use href="#i-check"></use></svg>Playbook changes</div>
                <div class="card-body">
                    @if (Model.WaitingChanges.Count == 0)
                    {
                        <p class="text-muted">Nothing is waiting for approval.</p>
                    }
                    else
                    {
                        <p>
                            @DisplayText.Count(Model.WaitingChanges.Count, "change is", "changes are") waiting for
                            @(Model.Me.Role == UserRole.HeadCoach ? "your decision." : "the head coach.")
                        </p>
                        <ul class="list-unstyled mb-3">
                            @foreach (var request in Model.WaitingChanges.Take(3))
                            {
                                <li class="mb-1">
                                    <a asp-controller="Approvals" asp-action="Details" asp-route-id="@request.Id">@DisplayText.Change(request.Action, request.TargetType): @request.TargetName</a>
                                    <span class="small text-muted">@request.RequestedBy</span>
                                </li>
                            }
                        </ul>
                    }
                    <a class="wr-more" asp-controller="Approvals" asp-action="Index">See all playbook changes<svg class="wr-icon wr-icon-sm"><use href="#i-arrow"></use></svg></a>
                </div>
            </div>
        </div>
    }

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header wr-card-title"><svg class="wr-icon wr-icon-sm"><use href="#i-users"></use></svg>Your account</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Me.FirstName @Model.Me.LastName</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Me.Email</dd>
                    <dt class="col-sm-4">Role</dt>
                    <dd class="col-sm-8">@User.GetRoleLabel()</dd>
                    <dt class="col-sm-4">Team</dt>
                    <dd class="col-sm-8">@Model.Me.TeamName</dd>
                </dl>
            </div>
        </div>
    </div>

    @if (Model.Me.Role != UserRole.Player)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header wr-card-title"><svg class="wr-icon wr-icon-sm"><use href="#i-shield"></use></svg>Your permissions</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-8">Publish playbook changes without approval</dt>
                        <dd class="col-sm-4">@(Model.Me.CanPublishPlaybook ? "Yes" : "No")</dd>
                        <dt class="col-sm-8">Edit the depth chart</dt>
                        <dd class="col-sm-4">@(Model.Me.CanEditDepthChart ? "Yes" : "No")</dd>
                        <dt class="col-sm-8">Record attendance</dt>
                        <dd class="col-sm-4">@(Model.Me.CanRecordAttendance ? "Yes" : "No")</dd>
                    </dl>
                </div>
            </div>
        </div>
    }
</div>
