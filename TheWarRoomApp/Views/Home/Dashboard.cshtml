@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3">Welcome, @Model.Me.FirstName</h1>
<p class="text-muted">@User.GetRoleLabel() &middot; @Model.Me.TeamName</p>

<div class="row g-4">
    @if (Model.Me.Role == UserRole.Player)
    {
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Your depth chart spots</div>
                <div class="card-body">
                    @if (Model.Week == null)
                    {
                        <p class="mb-0 text-muted">Your coaches have not posted a depth chart yet.</p>
                    }
                    else if (Model.MyPlacements.Count == 0)
                    {
                        <p class="text-muted">You are not listed on the current depth chart (@DisplayText.WeekOf(Model.Week)).</p>
                    }
                    else
                    {
                        <p class="text-muted small">@DisplayText.WeekOf(Model.Week)</p>
                        <ul class="list-unstyled mb-3">
                            @foreach (var placement in Model.MyPlacements)
                            {
                                <li>
                                    <strong>@placement.PositionName</strong>:
                                    @DisplayText.Ordinal(placement.Rank) of @placement.PlayersAtPosition
                                    @if (placement.Rank == 1)
                                    {
                                        <span class="badge text-bg-success">Starter</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (Model.Week != null)
                    {
                        <a asp-controller="DepthChart" asp-action="Index">See the full depth chart</a>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Depth chart</div>
                <div class="card-body">
                    @if (Model.Week == null)
                    {
                        <p class="text-muted">The team has no depth chart yet.</p>
                        <a asp-controller="DepthChart" asp-action="Index">Open the depth chart</a>
                    }
                    else
                    {
                        <p>@DisplayText.WeekOf(Model.Week)</p>
                        <a asp-controller="DepthChart" asp-action="Index">Open this week's depth chart</a>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Next on the schedule</div>
            <div class="card-body">
                @if (Model.NextEvents.Count == 0)
                {
                    <p class="text-muted">Nothing is scheduled from today onwards.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-3">
                        @foreach (var item in Model.NextEvents)
                        {
                            <li class="mb-2">
                                <a asp-controller="Schedule" asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                                <span class="badge wr-event-@item.EventType.ToString().ToLower()">@DisplayText.Event(item.EventType)</span>
                                <div class="small text-muted">
                                    @DisplayText.Date(item.EventDate), @DisplayText.Times(item.StartTime, item.EndTime) &middot; @item.Location
                                </div>
                            </li>
                        }
                    </ul>
                }
                <a asp-controller="Schedule" asp-action="Index">See the full schedule</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Playbook</div>
            <div class="card-body">
                @if (Model.Playbooks.Count == 0)
                {
                    <p class="mb-0 text-muted">No playbook is shared with you yet.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var playbook in Model.Playbooks)
                        {
                            <li class="mb-1">
                                <a asp-controller="Playbook" asp-action="Details" asp-route-id="@playbook.Id">@playbook.Name</a>
                                <span class="small text-muted">
                                    @DisplayText.Count(playbook.FormationCount, "formation", "formations"),
                                    @DisplayText.Count(playbook.PlayCount, "play", "plays")
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    @if (Model.Me.Role != UserRole.Player)
    {
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Playbook changes</div>
                <div class="card-body">
                    @if (Model.WaitingChanges.Count == 0)
                    {
                        <p class="text-muted">Nothing is waiting for approval.</p>
                    }
                    else
                    {
                        <p>
                            @DisplayText.Count(Model.WaitingChanges.Count, "change is", "changes are") waiting for
                            @(Model.Me.Role == UserRole.HeadCoach ? "your decision." : "the head coach.")
                        </p>
                        <ul class="list-unstyled mb-3">
                            @foreach (var request in Model.WaitingChanges.Take(3))
                            {
                                <li class="mb-1">
                                    <a asp-controller="Approvals" asp-action="Details" asp-route-id="@request.Id">@DisplayText.Change(request.Action, request.TargetType): @request.TargetName</a>
                                    <span class="small text-muted">@request.RequestedBy</span>
                                </li>
                            }
                        </ul>
                    }
                    <a asp-controller="Approvals" asp-action="Index">See all playbook changes</a>
                </div>
            </div>
        </div>
    }

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Your account</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Me.FirstName @Model.Me.LastName</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Me.Email</dd>
                    <dt class="col-sm-4">Role</dt>
                    <dd class="col-sm-8">@User.GetRoleLabel()</dd>
                    <dt class="col-sm-4">Team</dt>
                    <dd class="col-sm-8">@Model.Me.TeamName</dd>
                </dl>
            </div>
        </div>
    </div>

    @if (Model.Me.Role != UserRole.Player)
    {
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Your permissions</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-8">Publish playbook changes without approval</dt>
                        <dd class="col-sm-4">@(Model.Me.CanPublishPlaybook ? "Yes" : "No")</dd>
                        <dt class="col-sm-8">Edit the depth chart</dt>
                        <dd class="col-sm-4">@(Model.Me.CanEditDepthChart ? "Yes" : "No")</dd>
                        <dt class="col-sm-8">Record attendance</dt>
                        <dd class="col-sm-4">@(Model.Me.CanRecordAttendance ? "Yes" : "No")</dd>
                    </dl>
                </div>
            </div>
        </div>
    }
</div>
