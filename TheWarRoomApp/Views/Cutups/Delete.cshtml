@model CutupDetailDto

@{
    ViewData["Title"] = "Delete cutup";
}

<h1 class="h3">Delete cutup</h1>

<h3 class="h5">Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">Plays</dt>
        <dd class="col-sm-10">@Model.PlayCount, @TimeText.Length(Model.DurationMs) in all</dd>
        <dt class="col-sm-2">Shared with</dt>
        <dd class="col-sm-10">@(Model.SharedWith.Count == 0 ? "Nobody" : string.Join(", ", Model.SharedWith))</dd>
    </dl>
    @if (Model.SharedWith.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            The players this cutup is shared with will no longer see it.
        </div>
    }
    <p class="text-muted">The plays themselves stay on film and can be used in other cutups.</p>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Details" asp-route-id="@Model.Id">Back to the cutup</a>
    </form>
</div>
