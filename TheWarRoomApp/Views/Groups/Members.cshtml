@model GroupMembersViewModel

@{
    ViewData["Title"] = $"{Model.Kind} of {Model.GroupName}";
    bool players = Model.Kind == "Players";
}

<h1 class="h3">@Model.Kind of @Model.GroupName</h1>
<p class="text-muted">
    @DisplayText.Unit(Model.Unit).
    @if (players)
    {
        <span>Tick every player who belongs to this group. A player can be in several groups.</span>
    }
    else
    {
        <span>Tick every coach who coaches this group. A coach can have several groups.</span>
    }
</p>
<hr />

<form asp-action="@Model.Kind" asp-route-id="@Model.GroupId" method="post">
    @if (Model.Choices.Count == 0)
    {
        <p class="text-muted">There is nobody to choose from yet.</p>
    }
    <div class="row">
        @foreach (var choice in Model.Choices)
        {
            <div class="col-md-6 col-lg-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="selectedIds" value="@choice.Id" id="member-@choice.Id"
                           @(choice.IsSelected ? "checked" : "") />
                    <label class="form-check-label" for="member-@choice.Id">
                        @choice.Name
                        @if (!string.IsNullOrEmpty(choice.Detail))
                        {
                            <span class="text-muted small">&middot; @choice.Detail</span>
                        }
                    </label>
                </div>
            </div>
        }
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Save" class="btn btn-primary" /> |
        <a asp-action="Details" asp-route-id="@Model.GroupId">Back to group</a>
    </div>
</form>
