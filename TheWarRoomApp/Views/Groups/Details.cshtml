@model PositionGroupDto

@{
    ViewData["Title"] = Model.Name;
}

<h1 class="h3">@Model.Name</h1>
<p class="text-muted">@DisplayText.Unit(Model.Unit)</p>

@if (Model.CanManage)
{
    <p>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Rename</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Delete group</a>
    </p>
}
<hr />

<div class="row g-4">
    <div class="col-lg-5">
        <h2 class="h5">Positions</h2>
        @if (Model.Positions.Count == 0)
        {
            <p class="text-muted">This group has no positions yet.</p>
        }
        else
        {
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
        @foreach (var position in Model.Positions) {
                    <tr>
                        <td><strong>@position.Code</strong></td>
                        <td>
                            @position.Name
                            @if (position.Rules != null)
                            {
                                <span class="badge text-bg-light">@DisplayText.Rules(position.Rules.Value) only</span>
                            }
                            @if (position.IsPutAway)
                            {
                                <span class="badge text-bg-secondary" title="Left off the depth chart until the team plays this game again">Put away</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (Model.CanManage)
                            {
                                <a asp-action="EditPosition" asp-route-id="@position.Id">Edit</a>
                                <form asp-action="DeletePosition" asp-route-id="@position.Id" method="post" class="d-inline">
                                    <input type="hidden" name="groupId" value="@Model.Id" />
                                    | <button type="submit" class="btn btn-link p-0 align-baseline">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
        }
                </tbody>
            </table>
        }
        @if (Model.CanManage)
        {
            <a asp-action="CreatePosition" asp-route-groupId="@Model.Id">Add a position</a>
        }
    </div>

    <div class="col-lg-3">
        <h2 class="h5">Coaches</h2>
        @if (Model.Coaches.Count == 0)
        {
            <p class="text-muted">No coach is assigned to this group.</p>
        }
        else
        {
            <ul class="list-unstyled">
                @foreach (var coach in Model.Coaches)
                {
                    <li>@coach.FirstName @coach.LastName</li>
                }
            </ul>
        }
        @if (Model.CanAssignCoaches)
        {
            <a asp-action="Coaches" asp-route-id="@Model.Id">Change coaches</a>
        }
    </div>

    <div class="col-lg-4">
        <h2 class="h5">Players (@Model.Players.Count)</h2>
        @if (Model.Players.Count == 0)
        {
            <p class="text-muted">No players are in this group.</p>
        }
        else
        {
            <ul class="list-unstyled">
                @foreach (var player in Model.Players)
                {
                    <li>
                        <a asp-controller="Roster" asp-action="Details" asp-route-id="@player.Id">@DisplayText.Player(player.JerseyNumber, player.FirstName, player.LastName)</a>
                    </li>
                }
            </ul>
        }
        @if (Model.CanManage)
        {
            <a asp-action="Players" asp-route-id="@Model.Id">Change players</a>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>
