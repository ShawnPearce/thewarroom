@model SavePositionGroupDto

@{
    ViewData["Title"] = "Add a group";
}

<h1 class="h3">Add a group</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Unit" class="control-label"></label>
                <select asp-for="Unit" class="form-select">
                    <option value="@TeamUnit.Offence">Offence</option>
                    <option value="@TeamUnit.Defence">Defence</option>
                    <option value="@TeamUnit.SpecialTeams">Special teams</option>
                </select>
                <div class="form-text">A group stays in the unit it is created in.</div>
            </div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
