@model PositionGroupDto

@{
    ViewData["Title"] = "Delete group";
}

<h1 class="h3">Delete group</h1>

<h3 class="h5">Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Group</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Unit</dt>
        <dd class="col-sm-10">@DisplayText.Unit(Model.Unit)</dd>
        <dt class="col-sm-2">Positions</dt>
        <dd class="col-sm-10">@Model.Positions.Count</dd>
        <dt class="col-sm-2">Coaches</dt>
        <dd class="col-sm-10">@Model.Coaches.Count</dd>
        <dt class="col-sm-2">Players</dt>
        <dd class="col-sm-10">@Model.Players.Count</dd>
    </dl>
    @if (Model.Positions.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            A group that still has positions cannot be deleted. Delete its positions first.
        </div>
    }
    else
    {
        <p class="text-muted">The coaches and players stay on the team; they are only taken out of this group.</p>
    }
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Details" asp-route-id="@Model.Id">Back to group</a>
    </form>
</div>
