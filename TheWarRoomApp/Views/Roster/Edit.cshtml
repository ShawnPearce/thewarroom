@model PlayerEditViewModel

@{
    ViewData["Title"] = "Edit player";
}

<h1 class="h3">Edit @Model.FirstName @Model.LastName</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.PlayerId">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PlayerId" />

            @if (Model.CanEditAccount)
            {
                <div class="row">
                    <div class="form-group col-sm-6">
                        <label asp-for="FirstName" class="control-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-group col-sm-6">
                        <label asp-for="LastName" class="control-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            }
            else
            {
                @* Only the head coach changes names and emails; these keep the heading filled in if the form comes back *@
                <input type="hidden" asp-for="FirstName" />
                <input type="hidden" asp-for="LastName" />
            }

            <div class="row">
                <div class="form-group col-sm-6">
                    <label asp-for="JerseyNumber" class="control-label"></label>
                    <input asp-for="JerseyNumber" class="form-control" />
                    <span asp-validation-for="JerseyNumber" class="text-danger"></span>
                </div>
                <div class="form-group col-sm-6">
                    <label asp-for="Grade" class="control-label"></label>
                    <input asp-for="Grade" class="form-control" />
                    <span asp-validation-for="Grade" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="form-group col-sm-6">
                    <label asp-for="HeightInches" class="control-label"></label>
                    <input asp-for="HeightInches" class="form-control" />
                    <span asp-validation-for="HeightInches" class="text-danger"></span>
                </div>
                <div class="form-group col-sm-6">
                    <label asp-for="WeightLbs" class="control-label"></label>
                    <input asp-for="WeightLbs" class="form-control" />
                    <span asp-validation-for="WeightLbs" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="@RosterStatus.Active">Active</option>
                    <option value="@RosterStatus.Injured">Injured</option>
                    <option value="@RosterStatus.Inactive">Inactive</option>
                </select>
                <div class="form-text">An inactive player cannot be added to a depth chart.</div>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Details" asp-route-id="@Model.PlayerId">Back to player</a> |
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
