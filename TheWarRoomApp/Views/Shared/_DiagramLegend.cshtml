@model TeamUnit?

@* How to read the lines on a play diagram. The model is the unit of the play: an offensive or special teams
   play has routes and blocks, a defensive one has rushes and coverage, and both have motion.
   Without a unit (in the guide) every kind of line is shown. *@
@{
    bool offence = Model == null || Model != TeamUnit.Defence;
    bool defence = Model == null || Model == TeamUnit.Defence;
}
<ul class="list-unstyled small text-muted wr-legend mb-0">
    @if (offence)
    {
        <li>
            <svg width="44" height="14" aria-hidden="true">
                <line x1="2" y1="7" x2="34" y2="7" stroke="#0e1627" stroke-width="2" />
                <polygon points="42,7 32,3 32,11" fill="#0e1627" />
            </svg>
            Route
        </li>
        <li>
            <svg width="44" height="14" aria-hidden="true">
                <line x1="2" y1="7" x2="40" y2="7" stroke="#0e1627" stroke-width="2" />
                <line x1="40" y1="2" x2="40" y2="12" stroke="#0e1627" stroke-width="2" />
            </svg>
            Block
        </li>
    }
    @if (defence)
    {
        <li>
            <svg width="44" height="14" aria-hidden="true">
                <line x1="2" y1="7" x2="34" y2="7" stroke="#0e1627" stroke-width="2" />
                <polygon points="42,7 32,3 32,11" fill="#0e1627" />
            </svg>
            Rush
        </li>
        <li>
            <svg width="44" height="14" aria-hidden="true">
                <line x1="2" y1="7" x2="22" y2="7" stroke="#0e1627" stroke-width="2" />
                <ellipse cx="32" cy="7" rx="10" ry="5.5" fill="#1f51e6" fill-opacity="0.16" stroke="#0e1627" stroke-width="1.5" />
            </svg>
            Zone coverage: the defender drops to the oval
        </li>
        <li>
            <svg width="44" height="14" aria-hidden="true">
                <line x1="2" y1="7" x2="35" y2="7" stroke="#0e1627" stroke-width="2" stroke-dasharray="2 4" />
                <circle cx="39" cy="7" r="3" fill="none" stroke="#0e1627" stroke-width="1.5" />
            </svg>
            Man coverage: the line ends on the player who is covered
        </li>
    }
    <li>
        <svg width="44" height="14" aria-hidden="true">
            <line x1="2" y1="7" x2="34" y2="7" stroke="#0e1627" stroke-width="2" stroke-dasharray="5 3" />
            <polygon points="42,7 32,3 32,11" fill="#0e1627" />
        </svg>
        Motion before the snap
    </li>
</ul>
