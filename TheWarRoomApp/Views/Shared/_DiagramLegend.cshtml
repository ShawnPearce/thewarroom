@* How to read the lines on a play diagram *@
<ul class="list-unstyled small text-muted wr-legend mb-0">
    <li>
        <svg width="44" height="12" aria-hidden="true">
            <line x1="2" y1="6" x2="34" y2="6" stroke="#13233f" stroke-width="2" />
            <polygon points="42,6 32,2 32,10" fill="#13233f" />
        </svg>
        Route
    </li>
    <li>
        <svg width="44" height="12" aria-hidden="true">
            <line x1="2" y1="6" x2="40" y2="6" stroke="#13233f" stroke-width="2" />
            <line x1="40" y1="1" x2="40" y2="11" stroke="#13233f" stroke-width="2" />
        </svg>
        Block
    </li>
    <li>
        <svg width="44" height="12" aria-hidden="true">
            <line x1="2" y1="6" x2="34" y2="6" stroke="#13233f" stroke-width="2" stroke-dasharray="5 3" />
            <polygon points="42,6 32,2 32,10" fill="#13233f" />
        </svg>
        Motion before the snap
    </li>
</ul>
