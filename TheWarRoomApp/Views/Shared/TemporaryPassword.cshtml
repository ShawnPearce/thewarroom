@model TemporaryPasswordDto

@{
    ViewData["Title"] = "Temporary password";
    var backController = ViewData["BackController"] as string ?? "Staff";
}

<h1 class="h3">Temporary password for @Model.FirstName @Model.LastName</h1>

<div class="alert alert-warning" role="alert">
    This password is shown only once. Write it down or pass it on now; it cannot be looked up later.
</div>

<dl class="row">
    <dt class="col-sm-3">Sign-in email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.TemporaryPassword)
    </dt>
    <dd class="col-sm-9">
        <code class="fs-5">@Model.TemporaryPassword</code>
    </dd>
</dl>

<p class="text-muted">
    @Model.FirstName will be asked to choose their own password the first time they sign in.
    If the temporary password is lost, the head coach can reset it again.
</p>

<div>
    <a asp-controller="@backController" asp-action="Index">Back to list</a>
</div>
