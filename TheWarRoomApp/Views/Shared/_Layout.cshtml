@inject Microsoft.Extensions.Options.IOptions<SiteOptions> Site
@{
    bool signedIn = User.Identity?.IsAuthenticated == true;

    // The landing page and the sign-in pages lay out the whole width themselves and say so with ViewData["FullWidth"]
    bool fullWidth = ViewData["FullWidth"] as bool? == true;

    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // The menu entry of the section that is open is marked
    string At(params string[] controllers) => controllers.Contains(controller) ? "active" : "";
    string AtAction(string ofController, string ofAction) => controller == ofController && action == ofAction ? "active" : "";

    // The two letters in the circle beside the name
    string name = User.Identity?.Name ?? "";
    string initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part.Substring(0, 1))).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="theme-color" content="#0a101d"/>
    <title>@ViewData["Title"] - The War Room</title>
    <link rel="icon" href="~/favicon.ico" sizes="48x48"/>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml"/>
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png"/>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/TheWarRoomApp.styles.css" asp-append-version="true"/>
</head>
<body class="@(signedIn ? "wr-app" : "wr-site")">
<a class="wr-skip" href="#content">Skip to the page</a>
<partial name="_Icons"/>

@if (signedIn)
{
    @* Signed in: the menu stands at the side. On a narrow screen it slides in from the button in the top bar. *@
    <div class="wr-shell">
        <aside class="wr-sidebar">
            <div class="offcanvas-lg offcanvas-start" tabindex="-1" id="mainNav" aria-label="Main menu">
                <div class="wr-sidebar-inner">
                    <div class="wr-sidebar-top">
                        <a class="wr-brand" asp-area="" asp-controller="Home" asp-action="Dashboard">
                            <img src="~/favicon.svg" alt="" width="32" height="32"/>
                            <span>The War Room</span>
                        </a>
                        <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#mainNav"
                                aria-label="Close the menu"></button>
                    </div>

                    @* The menu shows what the signed-in role can use. The API still checks every request. *@
                    <nav class="wr-nav" aria-label="Sections">
                        <a class="wr-nav-link @AtAction("Home", "Dashboard")" asp-area="" asp-controller="Home" asp-action="Dashboard">
                            <svg class="wr-icon"><use href="#i-dashboard"></use></svg><span>Dashboard</span>
                        </a>

                        <div class="wr-nav-heading">Game plan</div>
                        <a class="wr-nav-link @At("DepthChart")" asp-area="" asp-controller="DepthChart" asp-action="Index">
                            <svg class="wr-icon"><use href="#i-depth"></use></svg><span>Depth chart</span>
                        </a>
                        <a class="wr-nav-link @At("Schedule")" asp-area="" asp-controller="Schedule" asp-action="Index">
                            <svg class="wr-icon"><use href="#i-calendar"></use></svg><span>Schedule</span>
                        </a>
                        <a class="wr-nav-link @At("Playbook")" asp-area="" asp-controller="Playbook" asp-action="Index">
                            <svg class="wr-icon"><use href="#i-playbook"></use></svg><span>Playbook</span>
                        </a>
                        @if (User.IsCoach())
                        {
                            <a class="wr-nav-link @At("Approvals")" asp-area="" asp-controller="Approvals" asp-action="Index">
                                <svg class="wr-icon"><use href="#i-check"></use></svg><span>Approvals</span>
                            </a>
                        }

                        <div class="wr-nav-heading">Film room</div>
                        @if (User.IsCoach())
                        {
                            <a class="wr-nav-link @At("Film")" asp-area="" asp-controller="Film" asp-action="Index">
                                <svg class="wr-icon"><use href="#i-film"></use></svg><span>Game film</span>
                            </a>
                            <a class="wr-nav-link @At("Cutups")" asp-area="" asp-controller="Cutups" asp-action="Index">
                                <svg class="wr-icon"><use href="#i-cutups"></use></svg><span>Cutups</span>
                            </a>
                            <a class="wr-nav-link @At("Tendencies")" asp-area="" asp-controller="Tendencies" asp-action="Index">
                                <svg class="wr-icon"><use href="#i-chart"></use></svg><span>Tendencies</span>
                            </a>
                            <a class="wr-nav-link @At("ScoutedTeams")" asp-area="" asp-controller="ScoutedTeams" asp-action="Index">
                                <svg class="wr-icon"><use href="#i-eye"></use></svg><span>Teams on film</span>
                            </a>
                        }
                        else
                        {
                            <a class="wr-nav-link @At("Cutups")" asp-area="" asp-controller="Cutups" asp-action="Index">
                                <svg class="wr-icon"><use href="#i-film"></use></svg><span>My film</span>
                            </a>
                            <a class="wr-nav-link @At("Activity")" asp-area="" asp-controller="Activity" asp-action="Mine">
                                <svg class="wr-icon"><use href="#i-clock"></use></svg><span>My study time</span>
                            </a>
                        }

                        <div class="wr-nav-heading">Team</div>
                        <a class="wr-nav-link @At("Roster")" asp-area="" asp-controller="Roster" asp-action="Index">
                            <svg class="wr-icon"><use href="#i-users"></use></svg><span>Roster</span>
                        </a>
                        <a class="wr-nav-link @At("Staff")" asp-area="" asp-controller="Staff" asp-action="Index">
                            <svg class="wr-icon"><use href="#i-staff"></use></svg><span>Coaching staff</span>
                        </a>
                        <a class="wr-nav-link @At("Groups")" asp-area="" asp-controller="Groups" asp-action="Index">
                            <svg class="wr-icon"><use href="#i-groups"></use></svg><span>Groups and positions</span>
                        </a>
                        @if (User.IsCoach())
                        {
                            <a class="wr-nav-link @At("Activity")" asp-area="" asp-controller="Activity" asp-action="Index">
                                <svg class="wr-icon"><use href="#i-clock"></use></svg><span>Study time</span>
                            </a>
                        }
                        @if (User.IsHeadCoach())
                        {
                            <a class="wr-nav-link @At("Team")" asp-area="" asp-controller="Team" asp-action="Settings">
                                <svg class="wr-icon"><use href="#i-settings"></use></svg><span>Team settings</span>
                            </a>
                        }
                    </nav>

                    @* The foot of the menu stays in sight however long the list above it is: the guide, then who is signed in *@
                    <div class="wr-sidebar-foot">
                        <a class="wr-nav-link @AtAction("Home", "Guide")" asp-area="" asp-controller="Home" asp-action="Guide">
                            <svg class="wr-icon"><use href="#i-book"></use></svg><span>Guide</span>
                        </a>

                        <div class="wr-sidebar-user dropup">
                            <button class="wr-user" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="wr-avatar" aria-hidden="true">@initials</span>
                                <span class="wr-user-text">
                                    <span class="wr-user-name">@name</span>
                                    <span class="wr-user-role">@User.GetRoleLabel() &middot; @User.GetTeamName()</span>
                                </span>
                                <svg class="wr-icon wr-icon-sm"><use href="#i-chevron"></use></svg>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">
                                        <svg class="wr-icon wr-icon-sm"><use href="#i-key"></use></svg>Change password
                                    </a>
                                </li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">
                                            <svg class="wr-icon wr-icon-sm"><use href="#i-signout"></use></svg>Sign out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <div class="wr-main">
            <header class="wr-topbar d-lg-none">
                <button class="wr-topbar-menu" type="button" data-bs-toggle="offcanvas" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-label="Open the menu">
                    <svg class="wr-icon"><use href="#i-menu"></use></svg>
                </button>
                <a class="wr-brand" asp-area="" asp-controller="Home" asp-action="Dashboard">
                    <img src="~/favicon.svg" alt="" width="28" height="28"/>
                    <span>The War Room</span>
                </a>
            </header>

            <main role="main" id="content" class="wr-content">
                @if (TempData["Message"] is string message)
                {
                    <div class="alert alert-success" role="status">@message</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }
                @if (TempData["ClearDraft"] is string savedDraft)
                {
                    @* A drawing was just saved: site.js removes the copy the play designer kept in this browser *@
                    <div hidden data-clear-draft="@savedDraft"></div>
                }
                @RenderBody()
            </main>

            <footer class="wr-footer">
                &copy; 2026 The War Room &middot; <a asp-area="" asp-controller="Home" asp-action="Guide">Guide</a>
                &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>
}
else
{
    @* Not signed in: a plain bar across the top. Over the landing page's picture and the guide's dark band it is see-through. *@
    <header class="wr-site-header @(fullWidth && controller == "Home" ? "wr-site-header-over" : "")">
        <div class="container wr-site-header-row">
            <a class="wr-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/favicon.svg" alt="" width="32" height="32"/>
                <span>The War Room</span>
            </a>
            <nav class="wr-site-nav" aria-label="Site">
                <a class="wr-site-link wr-site-link-always @AtAction("Home", "Guide")" asp-area="" asp-controller="Home" asp-action="Guide">Guide</a>
                @if (Site.Value.AllowRegistration)
                {
                    <a class="wr-site-link" asp-area="" asp-controller="Account" asp-action="Register">Register your team</a>
                }
                <a class="btn btn-light btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
            </nav>
        </div>
    </header>

    <main role="main" id="content" class="@(fullWidth ? "wr-wide" : "container wr-page")">
        @if (TempData["Message"] is string || TempData["Error"] is string)
        {
            <div class="@(fullWidth ? "wr-flash" : "")">
                @if (TempData["Message"] is string message)
                {
                    <div class="alert alert-success" role="status">@message</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }
            </div>
        }
        @RenderBody()
    </main>

    <footer class="wr-site-footer">
        <div class="container wr-site-footer-row">
            <span class="wr-brand wr-brand-quiet">
                <img src="~/favicon.svg" alt="" width="24" height="24"/>
                <span>The War Room</span>
            </span>
            <span>
                &copy; 2026 The War Room &middot; <a asp-area="" asp-controller="Home" asp-action="Guide">Guide</a>
                &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>
        </div>
    </footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (User.IsPlayer())
{
    @* The study timer. It does nothing on a page without a timer (see the _StudyTimer partial). *@
    <script src="~/js/study/view-tracker.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
