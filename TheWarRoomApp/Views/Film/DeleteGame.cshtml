@model GameDetailDto

@{
    ViewData["Title"] = "Delete game";
}

<h1 class="h3">Delete game</h1>

<h3 class="h5">Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Game</dt>
        <dd class="col-sm-10">@DisplayText.Matchup(Model)</dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.GameDate)
        </dt>
        <dd class="col-sm-10">@DisplayText.Date(Model.GameDate)</dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Label)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Label)
        </dd>
    </dl>
    @if (Model.VideoCount > 0)
    {
        <div class="alert alert-warning" role="alert">
            This game has video with @DisplayText.Count(Model.ClipCount, "play", "plays") cut from it.
            A game can only be deleted when it has no video, so film is never deleted by accident.
        </div>
    }
    <form asp-action="DeleteGame">
        <input type="hidden" asp-for="Id" />
        @if (Model.VideoCount == 0)
        {
            <input type="submit" value="Delete" class="btn btn-danger" /><text> |</text>
        }
        <a asp-action="Game" asp-route-id="@Model.Id">Back to the game</a>
    </form>
</div>
