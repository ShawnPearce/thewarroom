@model FilmIndexViewModel

@{
    ViewData["Title"] = "Game film";
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
    <h1 class="h3 mb-0">Game film</h1>
    <div>
        <a asp-controller="ScoutedTeams" asp-action="Index" class="btn btn-outline-primary">Teams on film</a>
        <a asp-controller="Cutups" asp-action="Index" class="btn btn-outline-primary">Cutups</a>
        <a asp-controller="Tendencies" asp-action="Index" class="btn btn-outline-primary">Tendencies</a>
        <a asp-action="CreateGame" class="btn btn-primary">Add a game</a>
    </div>
</div>
<p class="text-muted">
    The games you have film of: your own and your opponents'. A game's video is cut into plays, and the plays are tagged.
</p>

@* The team filter reloads the page as soon as another team is chosen *@
<form asp-action="Index" method="get" class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <label for="teamId" class="col-form-label">Show games of</label>
    </div>
    <div class="col-auto">
        <select id="teamId" name="teamId" class="form-select" data-auto-submit>
            <option value="">Every team</option>
            @foreach (var team in Model.Teams)
            {
                <option value="@team.Id" selected="@(team.Id == Model.TeamId)">@team.Name</option>
            }
        </select>
    </div>
</form>

@if (Model.Games.Count == 0)
{
    <p class="text-muted">@(Model.TeamId != null ? "There is no film of this team yet." : "No games have been added yet.")</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Game</th>
                    <th>Label</th>
                    <th>Videos</th>
                    <th>Plays</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
    @foreach (var item in Model.Games) {
                <tr>
                    <td class="text-nowrap">@DisplayText.Date(item.GameDate)</td>
                    <td>
                        <a asp-action="Game" asp-route-id="@item.Id">@DisplayText.Matchup(item)</a>
                    </td>
                    <td>@item.Label</td>
                    <td>@item.VideoCount</td>
                    <td>
                        @item.ClipCount
                        @if (item.ClipCount > 0)
                        {
                            <span class="small text-muted">(@item.TaggedClipCount tagged)</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="EditGame" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="DeleteGame" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
    }
            </tbody>
        </table>
    </div>
}
