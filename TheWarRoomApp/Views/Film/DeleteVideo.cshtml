@model VideoDetailDto

@{
    ViewData["Title"] = "Delete video";
    string matchup = $"{Model.AwayTeamName} at {Model.HomeTeamName}";
    int inCutups = Model.Clips.Count(c => c.CutupCount > 0);
}

<h1 class="h3">Delete video</h1>

<h3 class="h5">Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Video</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        <dt class="col-sm-2">Game</dt>
        <dd class="col-sm-10">@matchup, @DisplayText.Date(Model.GameDate)</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@DisplayText.VideoState(Model.Status)</dd>
        @if (!string.IsNullOrEmpty(Model.FileName))
        {
            <dt class="col-sm-2">File</dt>
            <dd class="col-sm-10">
                @Model.FileName@if (Model.SizeBytes != null)
                {<text>, @DisplayText.FileSize(Model.SizeBytes.Value)</text>}
            </dd>
        }
        <dt class="col-sm-2">Plays</dt>
        <dd class="col-sm-10">@Model.ClipCount cut, @Model.TaggedClipCount of them tagged</dd>
    </dl>
    @if (inCutups > 0)
    {
        <div class="alert alert-warning" role="alert">
            @DisplayText.Count(inCutups, "play", "plays") of this video @(inCutups == 1 ? "is" : "are") used in a cutup.
            A video can only be deleted when none of its plays is in a cutup. Take them out of the cutup first.
        </div>
    }
    else if (Model.ClipCount > 0)
    {
        <div class="alert alert-warning" role="alert">
            Deleting the video also deletes its @DisplayText.Count(Model.ClipCount, "play", "plays") and their tags.
            They will no longer count in the tendency charts. This cannot be undone.
        </div>
    }
    else if (Model.HasFile)
    {
        <p class="text-muted">The video file is deleted from film storage as well. This cannot be undone.</p>
    }
    <form asp-action="DeleteVideo">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="gameId" value="@Model.GameId" />
        @if (inCutups == 0)
        {
            <input type="submit" value="Delete" class="btn btn-danger" /><text> |</text>
        }
        <a asp-action="Game" asp-route-id="@Model.GameId">Back to the game</a>
    </form>
</div>
