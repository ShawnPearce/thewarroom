@model GameFormViewModel

@* The fields shared by the add and edit game pages *@
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row">
    <div class="form-group col-sm-6">
        <label asp-for="Game.AwayTeamId" class="control-label"></label>
        <select asp-for="Game.AwayTeamId" class="form-select">
            <option value="0">Choose a team</option>
            @foreach (var team in Model.Teams)
            {
                <option value="@team.Id">@team.Name</option>
            }
        </select>
        <span asp-validation-for="Game.AwayTeamId" class="text-danger"></span>
    </div>
    <div class="form-group col-sm-6">
        <label asp-for="Game.HomeTeamId" class="control-label"></label>
        <select asp-for="Game.HomeTeamId" class="form-select">
            <option value="0">Choose a team</option>
            @foreach (var team in Model.Teams)
            {
                <option value="@team.Id">@team.Name</option>
            }
        </select>
        <span asp-validation-for="Game.HomeTeamId" class="text-danger"></span>
    </div>
</div>
<p class="form-text mt-n2">
    An opponent that is not in the lists is added under
    <a asp-controller="ScoutedTeams" asp-action="Index">Teams on film</a> first.
</p>

<div class="row">
    <div class="form-group col-sm-6">
        <label asp-for="Game.GameDate" class="control-label"></label>
        <input asp-for="Game.GameDate" type="date" class="form-control" />
        <span asp-validation-for="Game.GameDate" class="text-danger"></span>
    </div>
    <div class="form-group col-sm-6">
        <label asp-for="Game.Label" class="control-label"></label>
        <input asp-for="Game.Label" class="form-control" />
        <span asp-validation-for="Game.Label" class="text-danger"></span>
        <div class="form-text">Optional, for example "Week 3" or "Scout film"</div>
    </div>
</div>

<div class="form-group">
    <label asp-for="Game.Notes" class="control-label"></label>
    <textarea asp-for="Game.Notes" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Game.Notes" class="text-danger"></span>
</div>
