@model SaveScheduledEventDto

@{
    ViewData["Title"] = "Edit event";
    var eventId = (int)ViewData["EventId"]!;
}

<h1 class="h3">Edit event</h1>
<hr />
<div class="row">
    <div class="col-md-7">
        <form asp-action="Edit" asp-route-id="@eventId">
            <partial name="_EventFields" />

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Details" asp-route-id="@eventId">Back to event</a> |
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
