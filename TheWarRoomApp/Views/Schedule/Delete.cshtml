@model ScheduledEventDto

@{
    ViewData["Title"] = "Delete event";
}

<h1 class="h3">Delete event</h1>

<h3 class="h5">Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EventType)
        </dt>
        <dd class="col-sm-10">@DisplayText.Event(Model.EventType)</dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EventDate)
        </dt>
        <dd class="col-sm-10">@DisplayText.Date(Model.EventDate), @DisplayText.Times(Model.StartTime, Model.EndTime)</dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Location)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Location)
        </dd>
    </dl>
    @if (Model.AttendanceCount > 0)
    {
        <div class="alert alert-warning" role="alert">
            Attendance has been recorded for @Model.AttendanceCount players at this event. Deleting the event deletes those records too,
            so only the head coach can do it.
        </div>
    }
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
